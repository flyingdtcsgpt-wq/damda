{
  "name": "damda",
  "version": "0.2.0",
  "description": "담다 — 암호화 개인 노트",
  "author": "damda",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.damda.notes",
    "productName": "Damda",
    "files": [
      "app/**",
      "desktop/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "app/icons/icon-512.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "녹음 기능에 마이크를 사용합니다."
      },
      "identity": "-"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "app/icons/icon-512.png"
    }
  }
}
